# =====================================================
# Dubai Cares Monitor - Environment Variables
# Copy this file to .env and fill in your credentials
# =====================================================

# --- Email Configuration ---
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password   # Use App Password, not Gmail password
EMAIL_TO=admin@example.com               # Comma-separated for multiple: a@b.com,c@d.com

# --- Pushover Mobile Notifications ---
# Sign up at https://pushover.net (free for 30 days, then $5 one-time)
# Install Pushover app on your iPhone/Android
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_API_TOKEN=your_pushover_app_token

# --- Twilio SMS (Optional) ---
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
TWILIO_TO=+9715XXXXXXXX                  # Your UAE mobile number

# --- Optional: Slack Notifications ---
SLACK_WEBHOOK_URL=                       # Leave empty to disable

# --- Optional: Custom SMTP (if not using Gmail) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=yourpassword
